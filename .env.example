# Copiar como .env.docker para Docker/WSL o .env.prod para producción.
# Los archivos reales están ignorados por Git.
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=core.settings.development
DEBUG=True
SECRET_KEY=change-this-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL. Dentro de Compose el host es "db".
POSTGRES_USER=axentra
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=axentra
DATABASE_URL=postgresql://axentra:change-this-password@db:5432/axentra

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.invalid
AXENTRA_OWNER_EMAIL=owner@example.invalid
AXENTRA_OWNER_DEFAULT_PASSWORD=change-this-password
ADMIN_SECRET_PATH=admin/
AXENTRA_CORE_VERBOSE_RADAR=False
